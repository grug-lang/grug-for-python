export run() {
    fib_numbers: List[number] = _fib_list(10)
    print(fib_numbers)
}

local _fib_list(n: number) List[number] {
    fib_list: List[number] = list()
    i: number = 0
    while i < n {
        fib_list.append(_fib(i))
        i = i + 1
    }
    return fib_list
}

local _fib(n: number) number {
    if n == 0 or n == 1 {
        return n
    }
    return _fib(n - 1) + _fib(n - 2)
}
