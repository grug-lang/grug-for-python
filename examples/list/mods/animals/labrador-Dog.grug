export run() {
    l: List[number] = list()

    l.append(1)
    l.append(2)
    l.append(3)
    l.append(4)
    _print_list(l, "[1, 2, 3, 4] at the start:")

    _print_number(l.len(), "4 after len():")

    l2: List[number] = list()
    l2.append(5)
    l2.append(6)
    l.extend(l2)
    _print_list(l, "[1, 2, 3, 4, 5, 6] after extend([5, 6]):")

    l.insert(2, 0)
    _print_list(l, "[1, 2, 0, 3, 4, 5, 6] after insert(2, 0):")

    l.remove(3)
    _print_list(l, "[1, 2, 0, 4, 5, 6] after remove(3):")

    x: number = l.pop()
    _print_list(l, "[1, 2, 0, 4, 5] after pop():")
    y: number = l.pop_index(1)
    _print_list(l, "[1, 0, 4, 5] after pop(1):")

    idx: number = l.index(4)
    _print_number(idx, "2 after index(4):")

    l.append(4)
    _print_list(l, "[1, 0, 4, 5, 4] after append(4):")
    _print_number(l.count(4), "2 after count(4):")

    l.sort()
    _print_list(l, "[0, 1, 4, 4, 5] after sort():")

    l.reverse()
    _print_list(l, "[5, 4, 4, 1, 0] after reverse():")

    l3: List[number] = l.copy()
    _print_list(l3, "[5, 4, 4, 1, 0] after copy():")

    l.clear()
    _print_list(l, "[] after clear():")
}

local _print_list(list: List[number], label: string) {
    print(label)
    print(list)
    print("")
}

local _print_number(list: number, label: string) {
    print(label)
    print(list)
    print("")
}
